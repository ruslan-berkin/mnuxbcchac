# Скопируйте этот файл в .env и укажите ключи. Файл .env в Git не попадает.
# Никогда не коммитьте реальные ключи.

# Какой провайдер использовать по умолчанию: gemini | groq | openai_compat
# Переопределяется флагом --provider.
LLM_PROVIDER=gemini

# Google Gemini (https://aistudio.google.com/ → Get API key)
GEMINI_API_KEY=your_gemini_api_key_here
# Точный ID модели из AI Studio. В коде ID не зашит.
GEMINI_MODEL=your_gemini_model_id_here
# Глубина рассуждений для рассуждающих моделей: low (по умолчанию, быстро) | default (не передавать)
# GEMINI_THINKING=low

# Запасные провайдеры. По умолчанию, если основной недоступен (лимит, 5xx), агент сам
# переходит к другим провайдерам, у которых заполнены ключ и модель.
# Порядок можно задать явно: LLM_FALLBACK=groq,gemini ; отключить: LLM_FALLBACK=none (или --no-fallback)
# LLM_FALLBACK=groq

# Groq (https://console.groq.com/keys). Работает через OpenAI-совместимый API.
GROQ_API_KEY=your_groq_api_key_here
# Точный ID модели из https://console.groq.com/docs/models
GROQ_MODEL=your_groq_model_id_here
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Любой другой OpenAI-совместимый сервер (OpenAI, OpenRouter, Ollama, vLLM)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=your_model_id_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# Ollama: OPENAI_BASE_URL=http://localhost:11434/v1 , OPENAI_API_KEY=ollama

# Лимиты и бюджет (необязательно). Имя = REQCHECK_ + поле из reqcheck/limits.py в верхнем регистре, например:
# REQCHECK_MAX_PAGES=100
# REQCHECK_MAX_LLM_CALLS=300
# REQCHECK_DEADLINE_S=900
# REQCHECK_WORKERS=4
# REQCHECK_CACHE_DIR=/абсолютный/путь/к/кэшу
# REQCHECK_MODEL_ALLOWLIST=model-a,model-b

# Сайт (server/): лимиты платного ключа
# SITE_LIVE=1
# SITE_DAILY_RUNS=5
# SITE_RUNS_PER_IP=1
# SITE_CHAT_PER_IP=40
# SITE_RECHECK_PER_IP=5
# SITE_DAILY_CHAT=300
# SITE_DAILY_RECHECK=40
# SITE_MAX_CHAT_TOKENS=1500
