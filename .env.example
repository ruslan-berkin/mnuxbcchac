# Скопируйте этот файл в .env и укажите ключ выбранного провайдера.
# Файл .env в Git не попадает. Никогда не коммитьте реальные ключи.

# Провайдер: gemini (по умолчанию) | openai_compat | fake
LLM_PROVIDER=gemini

# Google Gemini (https://aistudio.google.com/ → Get API key)
GEMINI_API_KEY=your_gemini_api_key_here
# Точный ID модели из AI Studio. В коде ID не зашит.
GEMINI_MODEL=your_gemini_model_id_here

# OpenAI-совместимый провайдер (OpenAI, OpenRouter, Ollama и т.п.)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=your_model_id_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# Ollama: OPENAI_BASE_URL=http://localhost:11434/v1 , OPENAI_API_KEY=ollama
